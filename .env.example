# --- SARH (صَرْح) environment ---
# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sarh?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-a-long-random-secret-for-production"

# Google OAuth (optional). When both values are present the "Sign in with Google"
# buttons work and /api/auth/[...nextauth] registers the Google provider;
# leave them empty and the rest of the platform still runs normally.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Absolute origin used for links inside emails (email verification) and OAuth
# callbacks. Must match the deployed origin in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional email — Resend (https://resend.com). Signup sends an email
# confirmation link through this key; when it is empty the link is written to
# the server log instead and the account stays unverified.
RESEND_API_KEY=""
# Must be a Resend-verified sender. `onboarding@resend.dev` works for testing.
EMAIL_FROM="SARH <onboarding@resend.dev>"

# Platform contact details — the fallback for the DB-backed `SiteSetting` rows
# edited from /admin/settings. Leave a value empty to keep the built-in default.
NEXT_PUBLIC_SUPPORT_PHONE="+970 599 000 000"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+970 599 000 000"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@sarh.ps"
NEXT_PUBLIC_SITE_LOCATION="غزة، فلسطين"

# Python FastAPI AI microservice (Phase 3). The public value is what the
# browser-side AI screens (quiz studio, receipt OCR) call directly.
NEXT_PUBLIC_FASTAPI_URL="http://localhost:8000"
# Server-side address used by the proxies (the parent-portal assistant at
# /api/parent/ai-chat). Falls back to NEXT_PUBLIC_FASTAPI_URL when unset — set
# it when the service lives on a private host that browsers cannot reach.
# FASTAPI_URL="http://localhost:8000"

# Optional social profiles shown in the site footer. Leave a value empty and
# that entry is simply not rendered, so the footer never carries a dead link.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""

# Optional intro video for the courses hero "watch the intro video" button.
# Accepts a direct video file (mp4/webm) or a YouTube link; when it is empty
# the modal shows a localized notice instead of a broken player.
NEXT_PUBLIC_INTRO_VIDEO_URL=""

# Seeding: prisma/seed.ts refuses to rewrite demo accounts when
# NODE_ENV=production. Set SEED_FORCE=1 only for a deliberate production seed.
# SEED_FORCE="1"
